<div>
  <h1>PasswordField Validate</h1>
  <form t:type="form" t:id="form">
    <t:errors/>
    <label>Saved <input t:type="passwordfield" t:id="saved"/></label>
    <label>PIN <input t:type="passwordfield" t:id="pin" t:validate="required,minlength=4"/></label>
    <input type="submit" id="submit" value="Submit"/>
  </form>
</div>
