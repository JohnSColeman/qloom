<t:panel heading="title">
  <h1>Hello, ${name}!</h1>
  <p class="greeting ${mood}">You have ${items.length} items.</p>
  <t:if test="hasItems">
    <t:loop source="items" value="item">
      <span class="item">${item} </span>
    </t:loop>
  </t:if>

  <p>
    <a href="#" t:type="eventlink" t:event="increment" t:zone="counter" id="bump">Increment</a>
  </p>
  <t:zone t:id="counter">
    <p id="count">Count: ${count}</p>
  </t:zone>
</t:panel>
